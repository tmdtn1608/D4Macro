<UserControl x:Class="D4Macro.View.Scenario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:D4Macro.View"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="450">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ItemsControl Grid.Row="0" ItemsSource="{Binding Scenarios, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <!-- 1. 조건 선택 -->
                        <ComboBox Width="80" 
                                  ItemsSource="{Binding Conditions}" 
                                  SelectedItem="{Binding SelectedCondition}"
                                  VerticalAlignment="Center"/>

                        <!-- 2. 중간 입력 (Trigger or Timeout) -->
                        
                        <!-- Case A: 버튼입력 (Trigger) -->
                        <ComboBox Width="50"  Margin="5,0,0,0"
                                  ItemsSource="{Binding ButtonInputs}" 
                                  SelectedItem="{Binding TriggerButton}"
                                  Visibility="{Binding IsTriggerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  VerticalAlignment="Center"/>
                        
                        <TextBlock Text="입력 후" 
                                   Visibility="{Binding IsTriggerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   VerticalAlignment="Center" 
                                   Margin="5,0,0,0"/>

                        <!-- Case B: 시간초과 (Timeout) -->
                        <TextBox Width="50"  Margin="5,0,0,0"
                                 Text="{Binding TimeoutValue}"
                                 Visibility="{Binding IsTimeoutVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 VerticalAlignment="Center"/>

                        <TextBlock Text="초 후" 
                                   Visibility="{Binding IsTimeoutVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   VerticalAlignment="Center" 
                                   Margin="5,0,0,0"/>

                        <!-- 3. 실행할 동작 (Action) -->
                        <ComboBox Width="50" Margin="5,0,0,0"
                                  ItemsSource="{Binding ButtonInputs}" 
                                  SelectedItem="{Binding ActionButton}"
                                  VerticalAlignment="Center"/>

                        <TextBlock Text="실행" 
                                   VerticalAlignment="Center" 
                                   Margin="5,0"/>

                        <!-- 4. 추가 버튼 -->
                        <Button Content="추가" 
                                Width="50" 
                                Margin="10,0,0,0"
                                Click="AddButton_Click"
                                Visibility="{Binding IsAddButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- 5. 삭제 버튼 -->
                        <Button Content="삭제" 
                                Width="50" 
                                Margin="5,0,0,0"
                                Click="DeleteButton_Click"
                                Visibility="{Binding IsDeleteButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 하단 버튼 추가 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="빠른저장" Width="90" Margin="5"/>
            <Button Content="빠른불러오기" Width="90" Margin="5"/>
            <Button Content="실행" Width="90" Margin="5"/>
        </StackPanel>
    </Grid>
</UserControl>
